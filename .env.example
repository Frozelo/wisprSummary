# Telegram bot token from @BotFather (keep secret, never commit .env)
TELEGRAM_BOT_TOKEN=
# Your private chat id: run `go run ./cmd/bot telegram-setup`, then send /start to the bot
TELEGRAM_CHAT_ID=

# Optional
# DATA_DIR=./data
# WISPR_MCP_URL=https://api.wisprflow.ai/connect/mcp
# LOG_LEVEL=info
# POLL_INTERVAL=2m     # minimum 30s; invalid values are rejected at startup
# LOOKBACK=48h          # how long a failed/unfinished meeting keeps being retried
# BACKFILL_HOURS=0      # on first run also send meetings modified in the last N hours
# TIMEZONE=Asia/Novosibirsk   # IANA zone for the message date (default: system local)
